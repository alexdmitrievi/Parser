# Скопируйте в .env и подставьте свои значения. Не коммитьте .env с реальными секретами.

# Telegram Bot (@BotFather) — обязательно для webhook / polling
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Supabase — Project Settings → API
# URL проекта
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# anon / public key (JWT, обычно начинается с eyJ...)
SUPABASE_KEY=YOUR_ANON_KEY_HERE
# service_role key (JWT) — для GitHub Actions status update, обход RLS; НЕ строка postgresql://
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Опционально: те же данные под другими именами (часть кода читает их)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ЕИС FTP (парсер eis_ftp)
EIS_FTP_HOST=ftp.zakupki.gov.ru

# Опционально: ScrapingBee для JS-heavy площадок
SCRAPING_BEE_API_KEY=

# Опционально: секрет для проверки webhook Telegram
BOT_WEBHOOK_SECRET=

# Логирование
LOG_LEVEL=INFO

# Лимиты бота (подписки)
MAX_FREE_SUBSCRIPTIONS=3

# ──────── Домен leads (китайские импортёры) ────────
# Весь домен выключен по умолчанию. При false ничего не запускается и
# поведение проекта не отличается от версии без этого модуля.
LEADS_ENABLED=false

# Хранилище: sqlite (по умолчанию, локальный файл) или supabase (таблицы leads_*)
LEADS_STORAGE=sqlite
LEADS_DB_PATH=data/leads.sqlite3

# Пути к конфигам (перечитываются на каждом запуске)
LEADS_PROFILES_PATH=config/leads_profiles.yaml
LEADS_BLACKLIST_PATH=config/leads_blacklist.txt

# ОБЯЗАТЕЛЬНО заменить: контактная почта в User-Agent краулера.
# По вежливому режиму владелец сайта должен иметь возможность с нами связаться.
LEADS_CONTACT_EMAIL=parser-abuse@example.com
# Переопределение всей строки User-Agent (обычно не нужно)
# LEADS_USER_AGENT=

# Список активных адаптеров через запятую. Пусто = все.
# LEADS_SOURCES=made_in_china,company_site

# Таможенные данные (Volza / ImportGenius / Panjiva) — платная подписка.
# Без ключа адаптер помечается как "требует подписки" и пропускается.
LEADS_CUSTOMS_API_KEY=
LEADS_CUSTOMS_API_PROVIDER=volza
LEADS_CUSTOMS_API_BASE_URL=

# Потолок уведомлений на одну подписку за прогон нотификатора.
# Защищает от лавины сообщений, когда парсер долго не работал и в базу
# разом попал большой бэклог. 0 — без ограничения.
MAX_NOTIFICATIONS_PER_SUBSCRIPTION=10
