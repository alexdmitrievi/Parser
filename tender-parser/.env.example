# Скопируйте в .env и подставьте свои значения. Не коммитьте .env с реальными секретами.

# ═══════════════ VPS-мониторинг (monitor/) — основной контур ═══════════════

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Ваш личный chat_id: бот отвечает ТОЛЬКО ему, остальных игнорирует.
# Узнать: напишите @userinfobot или @getmyid_bot
TELEGRAM_CHAT_ID=123456789

# Локальный PostgreSQL на VPS
DATABASE_URL=postgresql://tender:CHANGE_ME_PASSWORD@localhost:5432/tender_monitor

# ЕИС FTP: официальные XML-выгрузки. Анонимный доступ; исторически
# для раздела 223-ФЗ используется логин/пароль free/free.
EIS_FTP_HOST=ftp.zakupki.gov.ru
EIS_FTP_USER=free
EIS_FTP_PASS=free
# Максимум архивов за один цикл (ограничивает первый прогон)
EIS_FTP_MAX_ARCHIVES=300

# Файл бизнес-фильтров (перечитывается каждый цикл без рестарта)
# FILTERS_CONFIG=/opt/tender-parser/config/filters.yaml

# Резервный HTML-скрейпер ЕИС (по умолчанию выключен; 1 = включить)
EIS_HTML_FALLBACK=0

# Логи: journald всегда; дополнительно файл с ротацией (10 МБ × 5)
MONITOR_LOG_FILE=/var/log/tender-monitor/monitor.log
# Временный каталог для архивов FTP (удаляются после обработки)
MONITOR_TMP_DIR=/tmp/tender-monitor

# Бэкапы БД (scripts/backup_pg.sh): каталог и ротация в днях
BACKUP_DIR=/var/backups/tender-monitor
BACKUP_KEEP_DAYS=14

# Healthcheck: максимально допустимый возраст последнего цикла, часов
HEALTHCHECK_MAX_AGE_HOURS=5

# Логирование
LOG_LEVEL=INFO

# ═══════════════ Legacy (Vercel/GitHub Actions, грантовая часть) ═══════════════
# Нужны только если продолжаете пользоваться веб-витриной и грантами на Supabase.

# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_KEY=YOUR_ANON_KEY_HERE
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
# SCRAPING_BEE_API_KEY=
# BOT_WEBHOOK_SECRET=
# MAX_FREE_SUBSCRIPTIONS=3
